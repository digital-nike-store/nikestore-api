            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "example": "any"
                  },
                  "price": {
                    "example": "any"
                  },
                  "originalPrice": {
                    "example": "any"
                  },
                  "image": {
                    "example": "any"
                  },
                  "category": {
                    "example": "any"
                  },
